datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Status {
  PENDING
  APPROVED
}

model Suggestion {
  id          Int      @id @default(autoincrement())
  text        String
  status      Status   @default(PENDING)
  submittedAt DateTime @default(now())
}

model User {
  id       String @id @default(uuid())
  username String @unique
  password String
}
